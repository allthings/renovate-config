{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "customManagers:dockerfileVersions"
  ],
  "automerge": false,
  "automergeType": "branch",
  "circleci": {
    "enabled": false
  },
  "commitMessagePrefix": "⬆️ ",
  "configMigration": true,
  "docker-compose": {
    "enabled": false
  },
  "ignorePaths": [".github/actions/**"],
  "internalChecksFilter": "strict",
  "labels": ["renovate"],
  "lockFileMaintenance": {
    "enabled": true,
    "minimumReleaseAge": null,
    "schedule": [
      "on the 1st day instance on thursday after 6:00pm"
    ]
  },
  "minimumReleaseAge": "1 day",
  "minor": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Docker images and annotated versions in Dockerfiles ship with the next image build, so they are reviewed, not automerged",
      "matchManagers": ["dockerfile", "custom.regex"],
      "automerge": false
    },
    {
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "main dependencies patch updates"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "devDependencies non-major"
    },
    {                                                                  
      "matchPackageNames": ["@allthings/eslint-config", "cypress"],               
      "groupName": null                                                
    }
  ],
  "patch": {
    "automerge": true
  },
  "postUpdateOptions": ["yarnDedupeHighest"],
  "rebaseStalePrs": true,
  "schedule": [
    "on the 1st and 3rd day instance on saturday after 3:15am",
    "on the 1st and 3rd day instance on sunday after 3:15am"
  ],
  "timezone": "Europe/Berlin",
  "updateNotScheduled": false
}
